{
  // The Worker name must match the Worker you connect to GitHub in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asshalf",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // Free-plan accounts need SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
